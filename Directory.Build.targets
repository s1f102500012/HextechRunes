<Project>
  <!--
    本体、拓展包与测试三个"按游戏版本出变体"的工程共用的版本符号、目标校验与游戏引用。
    MSBuild 会把本文件自动导入仓库内所有工程,所以全部内容以 HextechUsesVariantTargets=true 为前提:
    只有显式声明它的工程才会被套用;加载器(固定对 0.107.1 编译)、mplab 驱动等工程不受影响。

    声明方需在自己的 PropertyGroup 里设置:
      HextechUsesVariantTargets = true
      HextechVariantTarget      = 本工程的目标版本(三个工程都取 HextechSts2Target)
      HextechGameRefsPrivate    = 是否把游戏程序集复制到输出(测试进程要 true,模组要 false;默认 false)
  -->

  <!--
    发布目标为 0.107.1 / 0.111.0 / 0.113.0 三个变体（0.110.0 已于 0.9.8 退役）。
    STS2_107_1 表示"0.107.1 分支";STS2_1xx_OR_NEWER 表示"该版本引入的 API 在本目标可用"。
    0.104~0.107.0 的符号已随这些版本退役,代码里不再出现。
  -->
  <PropertyGroup Condition="'$(HextechUsesVariantTargets)' == 'true' and '$(HextechVariantTarget)' == '0.107.1'">
    <DefineConstants>$(DefineConstants);STS2_107_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HextechUsesVariantTargets)' == 'true' and '$(HextechVariantTarget)' == '0.111.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER;STS2_109_OR_NEWER;STS2_110_OR_NEWER;STS2_111_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HextechUsesVariantTargets)' == 'true' and '$(HextechVariantTarget)' == '0.113.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER;STS2_109_OR_NEWER;STS2_110_OR_NEWER;STS2_111_OR_NEWER;STS2_113_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <!-- 未知目标不能静默落进 #else(最新 API)分支编译。 -->
  <Target Name="HextechValidateTarget"
          BeforeTargets="CoreCompile"
          Condition="'$(HextechUsesVariantTargets)' == 'true' and '$(HextechVariantTarget)' != '0.107.1' and '$(HextechVariantTarget)' != '0.111.0' and '$(HextechVariantTarget)' != '0.113.0'">
    <Error Text="$(MSBuildProjectName): target '$(HextechVariantTarget)' is not a shipped variant (0.107.1 / 0.111.0 / 0.113.0)." />
  </Target>

  <!--
    游戏引用:默认取仓库内按版本备份的引用目录 HextechRunes/versioned-dll-backups/<目标>/game-refs,
    也可用 -p:GameDataDir 显式指定。不回退到本机游戏安装:那里的程序集未必是本目标的版本,
    拿它编译别的变体会静默产出错版本的 DLL。
  -->
  <PropertyGroup Condition="'$(HextechUsesVariantTargets)' == 'true'">
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(MSBuildThisFileDirectory)HextechRunes/versioned-dll-backups/$(HextechVariantTarget)/game-refs</GameDataDir>
    <HextechGameRefsPrivate Condition="'$(HextechGameRefsPrivate)' == ''">false</HextechGameRefsPrivate>
  </PropertyGroup>

  <Target Name="HextechValidateGameRefs"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(HextechUsesVariantTargets)' == 'true' and !Exists('$(GameDataDir)/sts2.dll')">
    <Error Text="$(MSBuildProjectName): STS2 $(HextechVariantTarget) game assemblies not found in '$(GameDataDir)'. Copy them from a game install of exactly that version into HextechRunes/versioned-dll-backups/$(HextechVariantTarget)/game-refs/, or pass -p:GameDataDir=&lt;dir&gt;." />
  </Target>

  <ItemGroup Condition="'$(HextechUsesVariantTargets)' == 'true'">
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>$(HextechGameRefsPrivate)</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>$(HextechGameRefsPrivate)</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>$(HextechGameRefsPrivate)</Private>
    </Reference>
  </ItemGroup>
</Project>
