<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HextechRunesSponsorPack.Loader</AssemblyName>
    <RootNamespace>HextechRunesSponsorPack.Loader</RootNamespace>
    <Version>0.9.8</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 共享源码按此符号切换到拓展包自己的命名空间。 -->
    <DefineConstants>$(DefineConstants);HEXTECH_SPONSOR_LOADER</DefineConstants>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups/0.107.1/game-refs</GameDataDir>
  </PropertyGroup>

  <!--
    加载逻辑与本体共用一份源码,不再复制:只有 LoaderBootstrap.Identity.cs(mod id / 变体清单名 / 元数据键)
    留在本目录。本体那份 Identity 必须排除,否则两个 partial 会重复定义同名常量。
  -->
  <ItemGroup>
    <Compile Include="../../HextechRunes/loader/*.cs"
             Exclude="../../HextechRunes/loader/LoaderBootstrap.Identity.cs"
             Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HextechRunes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
